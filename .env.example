# Copiar a `.env` y completar con los valores del proyecto Firebase.
# Se obtienen con `flutterfire configure` o en la consola de Firebase:
# Configuración del proyecto → Tus apps → app Android.
# Uso: flutter run --dart-define-from-file=.env

FIREBASE_ANDROID_API_KEY=your-android-api-key
FIREBASE_ANDROID_APP_ID=1:000000000000:android:0000000000000000
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

# true = muestra el panel de simulación de fallos (solo demo/desarrollo)
DEMO_TOOLS=false
